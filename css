body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f0f2f5;
}

.topbar{
    background:#1877f2;
    color:white;
    padding:15px;
    text-align:center;
}

.create-post{
    background:white;
    padding:15px;
    margin:10px;
    border-radius:10px;
}

.create-post textarea{
    width:100%;
    height:80px;
}

.post{
    background:white;
    margin:10px;
    padding:15px;
    border-radius:10px;
}

.bottom-nav{
    position:fixed;
    bottom:0;
    width:100%;
    background:white;
    display:flex;
    justify-content:space-around;
    padding:10px;
}
